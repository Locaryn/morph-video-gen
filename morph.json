{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-video-gen",
  "version": "2.1.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Extension autonome de génération vidéo et d'animation d'images (AnimateDiff, CogVideoX, SVD) avec interface de studio intégrée. Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-video-gen",
  "repository": "https://github.com/Locaryn/morph-video-gen",
  "keywords": [
    "video-generation",
    "text-to-video",
    "animatediff",
    "cogvideox",
    "svd",
    "image-to-video"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de rendu vidéo local."
    },
    "files.read": {
      "reason": "Lire les modèles vidéo et images sources à animer."
    },
    "files.write": {
      "reason": "Sauvegarder les clips vidéos MP4 et séquences produites."
    },
    "network": {
      "reason": "Télécharger les modèles de diffusion vidéo depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "video-gen"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "video-gen-catalog",
        "slot": "marketplace.catalogs",
        "order": 18,
        "type": "data",
        "label": "Modèles de génération vidéo",
        "icon": "video",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles de génération vidéo au catalogue"
      },
      {
        "id": "video-gen-studio",
        "slot": "studio.tabs",
        "order": 18,
        "label": "Génération vidéo",
        "icon": "video",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-video-gen-panel",
        "hint": "Génération de clips et animation de scènes"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-video-gen#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-video-gen#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-video-gen#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-video-gen#v1.0.0"
    }
  ]
}
